# Allow index.php to receive PATH_INFO (e.g. /index.php/api/forecast).
# Scoped to index.php only to avoid side effects on static assets.
# Must be outside <IfModule> to be evaluated by Apache on all configurations.
<Files "index.php">
    AcceptPathInfo On
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP_HOST} ^(www\.)?meteo360\.zeffyr\.com$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.meteo360\.zeffyr\.com$ [NC]
    RewriteRule ^(.*)$ https://meteo360.zeffyr.com/$1 [R=301,L,NE]

    # OVH runs PHP via PHP-FPM (mod_proxy_fcgi). FPM rejects rewrites of the form
    # /index.php/<path-info> with `File not found.` because it cannot split the
    # synthetic PATH_INFO out of SCRIPT_FILENAME. Rewrite to /index.php strictly
    # and carry the original /api/... path through a custom Apache env variable.
    # Apache prefixes env vars with REDIRECT_ on every rewrite pass, so PHP will
    # see it as REDIRECT_MTO_PATH_INFO (or REDIRECT_REDIRECT_MTO_PATH_INFO on a
    # double pass). www/index.php scans $_SERVER for any *MTO_PATH_INFO key.
    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^api/?$ /meteo360/www/index.php [L,QSA,E=MTO_PATH_INFO:/api]

    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^api/(.*)$ /meteo360/www/index.php [L,QSA,E=MTO_PATH_INFO:/api/$1]

    # [END] stops all subsequent rewrite passes (Apache 2.4+), preventing the SPA
    # fallback from matching the rewritten /index.php URI on a second pass.
    RewriteRule ^api/?$ /index.php [END,QSA,E=MTO_PATH_INFO:/api]
    RewriteRule ^api/(.*)$ /index.php [END,QSA,E=MTO_PATH_INFO:/api/$1]

    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^$ /meteo360/www/dist/index.html [L]

    RewriteRule ^$ /dist/index.html [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/meteo360/www/dist/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/meteo360/www/dist/$1 -d
    RewriteRule ^(.+)$ /meteo360/www/dist/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
    RewriteRule ^(.+)$ /dist/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/meteo360/www/dist/index.html -f
    RewriteRule ^.*$ /meteo360/www/dist/index.html [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteRule ^.*$ /dist/index.html [L]
</IfModule>