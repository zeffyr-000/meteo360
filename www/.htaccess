# Allow index.php to receive PATH_INFO (e.g. /index.php/api/forecast).
# Scoped to index.php only to avoid side effects on static assets.
# Must be outside <IfModule> to be evaluated by Apache on all configurations.
<Files "index.php">
    AcceptPathInfo On
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP_HOST} ^(www\.)?meteo360\.zeffyr\.com$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.meteo360\.zeffyr\.com$ [NC]
    RewriteRule ^(.*)$ https://meteo360.zeffyr.com/$1 [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^api/?$ /meteo360/www/index.php/api [L,QSA]

    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^api/(.*)$ /meteo360/www/index.php/api/$1 [L,QSA]

    # [END] stops all subsequent rewrite passes (Apache 2.4+), preventing the SPA
    # fallback from matching the rewritten /index.php/api/... URI on a second pass.
    RewriteRule ^api/?$ /index.php/api [END,QSA]
    RewriteRule ^api/(.*)$ /index.php/api/$1 [END,QSA]

    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^$ /meteo360/www/dist/index.html [L]

    RewriteRule ^$ /dist/index.html [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/meteo360/www/dist/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/meteo360/www/dist/$1 -d
    RewriteRule ^(.+)$ /meteo360/www/dist/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
    RewriteRule ^(.+)$ /dist/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/meteo360/www/dist/index.html -f
    RewriteRule ^.*$ /meteo360/www/dist/index.html [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteRule ^.*$ /dist/index.html [L]
</IfModule>